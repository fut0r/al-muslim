{
  "name": "al-muslim",
  "private": true,
  "version": "2.0.0",
  "description": "Al-Muslim — a free, open-source, privacy-first Islamic companion: prayer times, Quran, adhkar, qiblah and Hijri calendar. Works offline.",
  "license": "GPL-3.0-only",
  "author": "Zyad Mohamed",
  "homepage": "https://github.com/fut0r/Al-Muslim",
  "repository": {
    "type": "git",
    "url": "https://github.com/fut0r/Al-Muslim.git"
  },
  "bugs": {
    "url": "https://github.com/fut0r/Al-Muslim/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "data:quran": "node scripts/build-quran-data.mjs",
    "data:cities": "node scripts/build-cities-data.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^9.4.0",
    "adhan": "^4.4.6",
    "geomagnetism": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "stylis": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
